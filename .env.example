NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB — use a dedicated support database (do not share Blivap collections)
MONGODB_URI=mongodb://localhost:27017/bliiva_support

# Redis — use a dedicated DB/prefix so BullMQ does not collide with Blivap.
# Production: set REDIS_URL (redis:// or rediss://). When set, it wins over host/port.
# REDIS_URL=rediss://default:PASSWORD@your-host:6379/1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_KEY_PREFIX=bliiva:
BULLMQ_PREFIX={bliiva}

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Service-to-service auth: Blivap backend → Bliiva
SUPPORT_SERVICE_API_KEY=change-me-support-service-key

# Blivap Integration Port (HTTP client for allowlisted account actions)
BLIVAP_API_BASE_URL=http://localhost:2001
BLIVAP_SERVICE_API_KEY=
BLIVAP_TIMEOUT_MS=10000
# http (default) or noop for local fail-closed stubs
BLIVAP_CLIENT=http
# Forward the Blivap user JWT as x-support-access-token on support requests
ACTION_CONFIRMATION_TTL_MS=300000

# Optional HS256 secret. When set, user identity comes from a verified Bearer JWT
# (`sub` or `userId`, plus `roles`) instead of trusted forwarding headers.
SUPPORT_USER_JWT_SECRET=

# Deterministic intelligence thresholds (matching scores, not probabilities)
AUTO_HANDLE_MIN_CONFIDENCE=0.85
CLARIFICATION_MIN_CONFIDENCE=0.6
INTENT_AMBIGUITY_MARGIN=0.08
INTENT_MIN_CANDIDATE_SCORE=0.34
INTENT_ALTERNATIVE_MIN_SCORE=0.18
KNOWLEDGE_MIN_SCORE=0.55
MAX_CLARIFICATION_ATTEMPTS=2
MAX_REPEATED_QUESTIONS=2
INTELLIGENCE_CACHE_TTL_MS=15000

# Self-hosted LLM (Ollama). Disabled by default so Phase 1/2 remain the
# fallback when the inference machine is down. Keep LLM_BASE_URL private.
# Switch to Qwen3 4B with LLM_MODEL=qwen3:4b when the host has enough RAM.
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:1.7b
LLM_ALTERNATIVE_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
LLM_MAX_CONTEXT_MESSAGES=10
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_CONTEXT_TOKENS=2048
LLM_NUM_CTX=2048
LLM_MAX_CONCURRENT=1
LLM_MAX_RETRIES=1
LLM_MAX_TOOL_CALLS=3
LLM_KEEP_ALIVE=5m
LLM_TURN_LIMIT=12
LLM_TURN_WINDOW_MS=60000

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=8

RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.55
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_CHARS_PER_TOKEN=4
RAG_MAX_CANDIDATES=400
RAG_SEMANTIC_WEIGHT=0.7
RAG_MAX_CHUNK_CHARS=800
VECTOR_STORE=mongodb
# Optional future vector DB. Leave empty for MongoDB cosine search.
QDRANT_URL=
QDRANT_COLLECTION=bliiva_knowledge

# NestJS Observe (optional locally)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
